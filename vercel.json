{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/widget/gamaguchi.svg",
      "destination": "/api/widget?format=svg"
    },
    {
      "source": "/api/widget",
      "destination": "/api/widget"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
